# Sovereign Security Layer - Root Shield
# Protect sensitive application files, databases, codebases, and credentials

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files and directories (like .env, .git)
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # Block direct access to sensitive directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule \.(env|json|lock|xml|yml|yaml|md|log|sqlite|sqlite3)$ - [F,L,NC]

    # Route all traffic to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes
